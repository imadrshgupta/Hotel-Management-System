# ── HMS Frontend Environment ──────────────────────────────────
# Copy this file to `.env` and adjust for your environment.

# Base URL for the API. In development the Vite dev server proxies
# /api → http://localhost:3000, so this can be left unset.
# VITE_API_URL=/api/v1

# WebSocket endpoint for real-time updates (room status, orders, etc.).
# In development the backend WS server runs on the API port at path /ws.
VITE_WS_URL=ws://localhost:3000